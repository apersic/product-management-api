generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  category    String
  priceCents  Int      @map("price_cents")
  tags        String[]

  @@map("products")
}
